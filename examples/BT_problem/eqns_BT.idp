// Define KSP parameters
  string KSPparams = "-ksp_type preonly -pc_type lu"; 
// term macros ------------------------------------------------------
    macro vdotu(v, u) ( v*u + v#B*u#B) // EOM
    macro grad(u) [dx(u), dy(u)] // EOM
// Boundary conditions
  macro BoundaryConditions(u, U) on(BCwall, u = U - 0.0, u#B = U#B) // EOM
  macro HomBoundaryConditions(u) on(BCwall, u = 0, u#B = 0) // EOM

// RESIDUAL OPERATOR
  varf vR(defu(dum), defu(v))
    = int2d(Th)(
        - v * ubB + params["D"] * grad(v)' * grad(ub)
        - vB * (params["a1"] + (params["a2"] + ub)*ubB + ub^2) + params["D"] * grad(vB)' * grad(ubB)
    )
    + BoundaryConditions(dum, ub);
// JACOBIAN OPERATOR
  varf vJ(defu(dum), defu(v))
    = int2d(Th)(
        iomega * vdotu(v, dum)
        - v * dumB + params["D"] * grad(v)' * grad(dum)
        - vB * ((params["a2"] + ub)*dumB + (2.0*ub + ubB)*dum) + params["D"] * grad(vB)' * grad(dumB)
    )
    + int2d(Th)(
        iomega * vdotu(v, um)
        - v * umB + params["D"] * grad(v)' * grad(um)
        - vB * ((params["a2"] + ub)*umB + (2.0*ub + ubB)*um) + params["D"] * grad(vB)' * grad(umB)
    )
    + HomBoundaryConditions(dum);
// MASS OPERATOR
    varf vM(defu(dum), defu(v))
        = int2d(Th)( vdotu(v, dum) )
        + int2d(Th)( vdotu(v, um) )
        + HomBoundaryConditions(dum);
// MASS DERIVATIVE OPERATOR
    varf vdM(defu(dum), defu(v))
        = HomBoundaryConditions(dum);
// MASS 2ND DERIVATIVE OPERATOR
  varf vddM(defu(dum), defu(v))
    = HomBoundaryConditions(dum);

// FORCING/RESPONSE OPERATORS
  varf vMq(defu(dum), defu(v))
    = int2d(Th)( vdotu(v, dum) )
    + int2d(Th)( vdotu(v, um) )
    + HomBoundaryConditions(dum);

  varf vMf(deff(fm), deff(v))
    = int2d(Th)( vdotu(v, fm) );

  varf vP(deff(fm), defu(v))
    = int2d(Th)( vdotu(v, fm) );
// HESSIAN OPERATOR
  varf vH(defu(dum), defu(v))
    = int2d(Th)(
        - vB * (dum*umB + (2.0*dum + dumB)*um)
    )
    + int2d(Th)(
        - vB * (um2*umB + (2.0*um2 + um2B)*um)
    )
    + HomBoundaryConditions(dum);