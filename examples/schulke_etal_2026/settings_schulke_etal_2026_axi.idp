// NOTE: When starting a project this is one of the main files that should be edited
//
// Set dimension macro for 'macro_ddm.idp' (2)
  macro dimension()2//EOM
// Declare that cubic and quartic nonlinear terms exist and their partials are defined
  macro cubic()//EOM
  macro quartic()//EOM
// Load hpddm macros
  include "macro_ddm.idp"
  verbosity = getARGV("-v", 0);
// Define parameter and monitor names
  real paramAFR, paramAs, paramTs, paramTa, paramvfO2;
  { 
    real WCH4 = 16.0425; // molecular weight of CH4 [g/mol]
    real WO2 = 31.9988; // molecular weight of O2 [g/mol]
    paramvfO2 = 0.2095; // volume fraction of O2 in air [-]
    real massfracO2 = 0.2314; // mass fraction of O2 in air [-]
    real Uref = 1.0; // velocity scale [m/s]
    real Lref = 0.011; // length scale [m]
    real Tref = 300.0; // reference temperature [K]
    real pref = 1.01325e5; // reference pressure [Pa]
    real Ar = 1.1e7; // Arrhenius frequency factor [g/m-s-K^(1/2)]
    real As = 1.67212e-3; // Sutherland constant [g/m-s-K^(1/2)]
    real Ts = 170.672; // Sutherland temperature [K]
    real Ru = 8.31446261815324; // Universal gas constant [J/K-mol]
    real Ea = 20.0e3*4.184; // molar activation energy [J/mol]
    real Dh0fCH4 = -74.87e3; // enthalpy of formation of methane [J/mol]
    real Dh0fH2O = -241.83e3; // enthalpy of formation of water vapor [J/mol]
    real Dh0fCO2 = -393.52e3; // enthalpy of formation of carbon dioxide [J/mol]
    real Dh0r = Dh0fCO2 + 2.0*Dh0fH2O - Dh0fCH4; // enthalpy of reaction [J/mol]
    real Cp = 1.3; // specific heat at constant pressure [J/g-K]
    paramAFR = 2.0*WO2/(massfracO2*WCH4); //stoichiometric air-fuel mass ratio [-]
    real Dhc = -Dh0r/(Cp*Tref*WCH4); //dimensionless combustion enthalpy
    real Da = Ar*Lref/Uref*(2*pref/(Ru*Tref))^0.5; //Damkohler number
    paramAs = As*Uref/Lref*Ru*Tref^1.5/(WCH4*pref); //Dimensionless Sutherland constant
    paramTs = Ts/Tref; //Dimensionless Sutherland temperature
    paramTa = Ea/Ru/Tref; //Dimensionless activation temperature
/*    cout.precision(17);
    if(mpirank==0) {
      cout << "AFR = " << paramAFR << endl;
      cout << "As = " << paramAs << endl;
      cout << "Ts = " << paramTs << endl;
      cout << "Ta = " << paramTa << endl;
      cout << "Da = " << Da << endl;
      cout << "Dhc = " << Dhc << endl;
    }*/
  }
  real paramPr = 0.71; //Prandtl number
  real paramSc = 0.71; //Schmidt number
  string[int] paramnames = ["Re", "Tr", "Da", "phi", "Dhc"]; // set parameter names
  string[int] monitornames = ["U0", "dT", "Ze", "uxpt", "omegadotT"]; // set monitor names
// Declare symmetries
  real[int] sym(1);
// Define state vector and FE space
  macro defu(u)[u, u#y, u#Y, u#T, u#p]//EOM
  macro initu(i)[i, i, i, i, i]//EOM
  func Pk = [P2, P2, P2, P2, P1];
// Define forcing vector and FE space (for resolvent analysis)
  macro deff(f)[f, f#y]//EOM
  macro initf(i)[i, i]//EOM
  func Pkf = [P2, P2];
// Define quantities for mesh adaptation and plotting in Paraview
  macro adaptu(u)[u, u#y], u#Y, u#T, u#p //EOM
  macro adaptf(f)[f, f#y] //EOM
  macro paraviewu(u)[u, u#y, 0*u], u#Y, u#T, u#p//EOM
  macro paraviewf(f)[f, f#y, 0*f] //EOM
// Name and order for real Paraview outputs
  string ParaviewDataName = "velocity species temperature pressure";
  string ParaviewDataNamef = "momentum";
  int[int] ParaviewOrder = [1, 1, 1, 1];
  int[int] ParaviewOrderf = [1];
// Name and order for complex Paraview outputs
  string ParaviewDataNamec = "velocity_r species_r temperature_r pressure_r";
  ParaviewDataNamec = ParaviewDataNamec + " velocity_i species_i temperature_i pressure_i";
  string ParaviewDataNamefc = "momentum_r momentum_i";
  int[int] ParaviewOrderc = [ParaviewOrder, ParaviewOrder];
  int[int] ParaviewOrderfc = [ParaviewOrderf, ParaviewOrderf];
  // Initial conditions (if no file)
  macro InitialConditions()[0, 0, 1, 1, 0]//EOM
// Boundary labels
  int BCnull = 0;
  int BCaxis = 1;
  int BCopen = 2;
  int BClateral = 3;
  int BCwall = 4;
  int BCchannel = 5;
  int BCinflow = 6;
  int BCcenterbody = 7;
// Some helpful macros
// possibly only act on real Y?
macro RRY(u) ((u#Y + fdim(params["phi"], 1.0))*sqrt(u#Y + fdim(1.0/params["phi"], 1.0))) // EOM
macro dRRY(u) (sqrt(u#Y + fdim(1.0/params["phi"], 1.0)) + 0.5*(u#Y + fdim(params["phi"], 1.0))/sqrt(u#Y + fdim(1.0/params["phi"], 1.0))) // EOM
macro d2RRY(u) ( (1.0 - 0.25*(u#Y + fdim(params["phi"], 1.0))/(u#Y + fdim(1.0/params["phi"], 1.0)))/sqrt(u#Y + fdim(1.0/params["phi"], 1.0))) // EOM
macro d3RRY(u) ((0.375*(u#Y + fdim(params["phi"], 1.0))/(u#Y + fdim(1.0/params["phi"], 1.0)) - 0.75)/(u#Y + fdim(1.0/params["phi"], 1.0))^1.5) // EOM
macro d4RRY(u) ((1.5 - 0.9375*(u#Y + fdim(params["phi"], 1.0))/(u#Y + fdim(1.0/params["phi"], 1.0)))/(u#Y + fdim(1.0/params["phi"], 1.0))^2.5) // EOM

macro RRTT(u) (exp(-paramTa/u#T)/sqrt(u#T)) // EOM
macro dRRTT(u) ((paramTa/u#T - 0.5)/u#T^1.5*exp(-paramTa/u#T)) // EOM
macro d2RRTT(u) (((paramTa/u#T - 3.0)*paramTa/u#T + 0.75)/u#T^2.5*exp(-paramTa/u#T)) // EOM
macro d3RRTT(u) ((((paramTa/u#T - 7.5)*paramTa/u#T + 11.25)*paramTa/u#T - 1.875)/u#T^3.5*exp(-paramTa/u#T)) // EOM
macro d4RRTT(u) (((((paramTa/u#T - 14.0)*paramTa/u#T + 52.5)*paramTa/u#T - 52.5)*paramTa/u#T + 6.5625)/u#T^4.5*exp(-paramTa/u#T)) // EOM

// Define solution monitors to extract
macro getmonitors(){
  monitors["U0"] = params["Re"]/(1.0 + paramTs)*paramAs*(params["phi"] + 2.0/paramvfO2)/(paramAFR + params["phi"]);
  monitors["dT"] = min(1.0, params["phi"])/(paramAFR + params["phi"])*params["Dhc"];
  monitors["Ze"] = paramTa*monitors["dT"]/(1.0 + monitors["dT"])^2;
  monitors["uxpt"] = ubg(3., 1.3);
  monitors["omegadotT"] = int2d(Thg)(y*params["Dhc"]*params["Da"]*(1.0 + paramTs)/(params["Re"]*paramAs)*(min(1.0, params["phi"])/(params["phi"] + 2.0/paramvfO2))^1.5*RRY(ubg)*RRTT(ubg)/ubgT);
} // EOM
